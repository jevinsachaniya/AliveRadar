NODE_ENV=development
DATABASE_URL=postgresql://pulse:pulse_local_only@127.0.0.1:54329/uptimepulse?connection_limit=10
APP_ORIGIN=http://localhost:5173
PORT=3001
# Optional: after npm run build, serve React from the Python API on the same origin.
# Set APP_ORIGIN to that API's origin if enabling this locally. Render configures it separately.
WEB_DIST_DIR=
SESSION_DAYS=7
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Keep private and persistent. Required for login and registration email OTP.
AUTH_OTP_SECRET=
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000
RETENTION_DAYS=90
# The ONLY permitted private target in development. Never set in production.
DEV_MOCK_ORIGIN=http://127.0.0.1:4005
# Brevo SMTP: use your SMTP login and SMTP key (not the HTTP API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Replace with an email verified in Brevo before enabling delivery.
SMTP_FROM=AliveRadar <alerts@example.com>
# Required by Docker Compose; choose a secret for deployments.
POSTGRES_PASSWORD=pulse_local_only
