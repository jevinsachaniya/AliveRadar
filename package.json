{
  "name": "uptimepulse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web,mock \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\" \"npm run mock\"",
    "dev:built": "concurrently -k -n api,worker,web,mock \"npm run start:api\" \"npm run start:worker\" \"npm run dev:web\" \"npm run mock\"",
    "dev:api": "node scripts/python.mjs -m backend.cli api --reload",
    "dev:worker": "node scripts/python.mjs -m backend.cli worker",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "mock": "node scripts/python.mjs -m backend.cli mock",
    "db:local": "node scripts/python.mjs -m backend.cli local-db",
    "db:migrate": "node scripts/python.mjs -m backend.cli migrate",
    "db:seed": "node scripts/python.mjs -m backend.cli seed",
    "seo:files": "node scripts/python.mjs -m backend.cli seo-files",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/prerender.mjs",
    "start:api": "node scripts/python.mjs -m backend.cli api",
    "start:worker": "node scripts/python.mjs -m backend.cli worker",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit && node scripts/python.mjs -m mypy backend",
    "lint": "eslint . && node scripts/python.mjs -m ruff check backend",
    "test": "npm run test:web && npm run test:python",
    "test:integration": "node scripts/python.mjs -m backend.cli test-integration",
    "test:e2e": "playwright test",
    "health": "node scripts/python.mjs -m backend.cli health",
    "verify:worker": "node scripts/python.mjs -m backend.cli verify-worker",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"tests/**/*.{ts,tsx}\" \"*.{ts,js,json,yml}\" \"docs/*.md\" README.md && node scripts/python.mjs -m ruff format --check backend",
    "test:web": "vitest run",
    "test:python": "node scripts/python.mjs -m pytest -m \"not integration\"",
    "audit:python": "node scripts/python.mjs -m pip_audit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
